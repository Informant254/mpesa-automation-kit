# sandbox or production
MPESA_ENVIRONMENT=sandbox

CONSUMER_KEY=
CONSUMER_SECRET=
SHORTCODE=
PASSKEY=

# Public HTTPS base URL for callbacks, e.g. https://your-app.onrender.com
# On Render this is discovered automatically from RENDER_EXTERNAL_HOSTNAME.
PUBLIC_BASE_URL=

# Optional per-route overrides. Leave blank to derive from PUBLIC_BASE_URL / Render hostname.
CALLBACK_URL=
B2C_RESULT_URL=
B2C_TIMEOUT_URL=
BALANCE_RESULT_URL=
BALANCE_TIMEOUT_URL=
STATUS_RESULT_URL=
STATUS_TIMEOUT_URL=
C2B_CONFIRMATION_URL=
C2B_VALIDATION_URL=

# Required for B2C / balance / transaction status, not basic STK Push.
INITIATOR_NAME=
SECURITY_CREDENTIAL=

# Callback persistence
MPESA_DB_PATH=mpesa_events.db

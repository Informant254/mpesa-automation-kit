# sandbox or production
MPESA_ENVIRONMENT=sandbox

CONSUMER_KEY=
CONSUMER_SECRET=
SHORTCODE=
PASSKEY=

# STK callback
CALLBACK_URL=https://your-domain.example/mpesa/stk/callback

# B2C / balance / transaction status credentials
INITIATOR_NAME=
SECURITY_CREDENTIAL=
B2C_RESULT_URL=https://your-domain.example/mpesa/b2c/result
B2C_TIMEOUT_URL=https://your-domain.example/mpesa/b2c/timeout
BALANCE_RESULT_URL=https://your-domain.example/mpesa/balance/result
BALANCE_TIMEOUT_URL=https://your-domain.example/mpesa/balance/timeout
STATUS_RESULT_URL=https://your-domain.example/mpesa/status/result
STATUS_TIMEOUT_URL=https://your-domain.example/mpesa/status/timeout

# C2B callbacks
C2B_CONFIRMATION_URL=https://your-domain.example/mpesa/c2b/confirmation
C2B_VALIDATION_URL=https://your-domain.example/mpesa/c2b/validation

# Callback persistence
MPESA_DB_PATH=mpesa_events.db
